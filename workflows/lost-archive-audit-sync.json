    {
      "id": "909e8c50-c3cf-44bf-975f-5704cd17136d",
      "name": "Build audited snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 0],
      "parameters": {
        "jsCode": "const columns=['Contact Name','Salesperson','Mobile','Phone','Course Categories','Closed Date','Lost Reason','Validate','Note','Modify By','Created on','Campaign Name']; const all=[]; const counts={}; for(const month of ['Aug','Sep','Oct']){ const source=$('Read '+month).all().map(item=>item.json); const rows=source.map((raw,index)=>{ const verdict=String(raw.Validate||'').trim().toLowerCase(); if(!['yes','no'].includes(verdict)) return null; const row={__sheet_month:month,__stable_key:'2026-'+month+':'+String(raw.row_number||index+2)}; for(const column of columns) row[column]=String(raw[column]??''); return row; }).filter(Boolean); if(rows.length<100) throw new Error(month+' primary tab incomplete: '+rows.length); counts[month]=rows.length; all.push(...rows); } const unique=new Set(all.map(row=>row.__stable_key)); if(unique.size!==all.length) throw new Error('Duplicate sheet row keys'); return [{json:{payload:{dataset:'lost_archive_audit',mode:'replace',rows:all,syncedAt:new Date().toISOString(),metadata:{source:'Lost Archive Google Sheet',sheetId:'1r_KWVc-uUpj0xiNsq9hQgfyh83C52k3diDhsq6rrxWw',primaryTabs:['Aug','Sep','Oct'],counts,validationTabsExcluded:true}}}}];"
      }
    },
    {
      "id": "28f127b8-ad11-4bb0-b239-a45ff8626447",
      "name": "Replace Lost Archive in Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1792, 0],
      "parameters": {
        "method": "POST",
        "url": "https://engosoft-insights-hub-production.up.railway.app/api/ingest/dataset",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-ingest-secret", "value": "__INGEST_SECRET__" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.payload) }}",
        "options": { "timeout": 180000 }
      }
    },
    {
      "id": "ed46704e-e1d9-4a1b-94f7-3805ec53c3ec",
      "name": "Verify complete ingest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2016, 0],
      "parameters": { "jsCode": "const result=$input.first().json; const sent=$('Build audited snapshot').first().json.payload.rows.length; if(result.ok!==true||Number(result.rowCount)!==sent) throw new Error('Dashboard Lost Archive ingest count mismatch: sent '+sent+', stored '+result.rowCount); return [{json:{ok:true,receivedRows:sent,syncedAt:result.syncedAt}}];" }
    }
